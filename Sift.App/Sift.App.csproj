<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sift.Core\Sift.Core.csproj" />
  </ItemGroup>

  <!-- Paper UI framework (relative path from this project to the Paper repo) -->
  <ItemGroup>
    <ProjectReference Include="../../../Frameworks/Paper/Paper.Core/Paper.Core.csproj" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.Layout/Paper.Layout.csproj" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.Icons/Paper.Icons.csproj" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.Rendering.Silk.NET/Paper.Rendering.Silk.NET.csproj" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.Rendering.Silk.NET.HotReload/Paper.Rendering.Silk.NET.HotReload.csproj" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.CSX/Paper.CSX.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../Frameworks/Paper/Paper.CSSS/Paper.CSSS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for CSX hot-reload runtime compiler (AdhocWorkspace / Formatter) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <!-- CSX source files, picked up by the Paper.CSX source generator and copied for hot reload -->
  <ItemGroup>
    <AdditionalFiles Include="src\**\*.csx" />
    <Content Include="src\**\*.csx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="src\**\*.csss" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\header-glyph.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- NOTE: Inter (SIL OFL, see Inter-LICENSE.txt) as it's close to SF, which Spot uses. SF itself drops some spaces in
         Paper. inter-bold is the SemiBold cut, for headings -->
    <Content Include="Assets\fonts\inter.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\fonts\inter-bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
