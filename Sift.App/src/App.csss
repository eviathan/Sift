/* App.csss - Sift styles, after Spot's default theme */

/* -- Palette -------------------------------------------------------------------- */
$page:           #262C3D;
$panel:          #2A2D3D;
$card:           #222530;
$header:         #CBCACC;
$footer:         #000000;
$text:           #FFFFFF;
$secondary:      #8B96B2;
$dimmed:         #3C4661;
$accent:         #8CD973;
$error:          #FF8080;
$warning-text:   #FF9F0A;

/* -- Window --------------------------------------------------------------------- */
.root {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  background: $page;
  overflow: hidden;
  user-select: none;
}

/* The bar at the top, under the (transparent) title bar: AppKit drags the window from it */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  background: $header;
  flex-shrink: 0;
}

.header-side {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-grow: 1;
  flex-basis: 0;
}

.header-right {
  justify-content: flex-end;
  padding-right: 18px;
}

.header-title {
  color: #5C5F6B;
  font-size: 12px;
}

.body {
  display: flex;
  flex-direction: row;
  flex-grow: 1;
  min-height: 0;
  position: relative;
  background: $panel;
}

/* -- Scene ---------------------------------------------------------------------- */
.scene {
  display: flex;
  flex-grow: 1;
  position: relative;
  overflow: hidden;
  min-width: 0;
  border-right: 1px solid rgba(255, 255, 255, 0.06);
}

.scene-badge {
  position: absolute;
  left: 16px;
  top: 14px;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.scene-badge-text {
  color: $text;
  font-size: 15px;
  font-weight: bold;
}

.scene-badge-note {
  color: $secondary;
  font-size: 11px;
  margin-top: 2px;
}

/* Floating zoom controls, bottom left of the scene */
.scene-tools {
  position: absolute;
  left: 14px;
  bottom: 14px;
  display: flex;
  flex-direction: row;
  padding: 3px;
  border-radius: 10px;
  background: rgba(20, 23, 33, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

/* -- Sidebar -------------------------------------------------------------------- */
/* NOTE: Pinned to the body's edges, Paper doesn't stretch a flex child to its row's height */
.sidebar {
  display: flex;
  flex-direction: column;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 320px;
  overflow: hidden;
}

/* A block of the sidebar, separated from the next by a hairline */
.section {
  display: flex;
  flex-direction: column;
  padding: 14px 16px;
  gap: 9px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

/* A small capitalised heading, as Spot's */
.heading {
  color: $secondary;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.8px;
}

.badge {
  color: $warning-text;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 8px;
  background: rgba(255, 159, 10, 0.15);
}

.card {
  display: flex;
  flex-direction: column;
  padding: 12px;
  gap: 8px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 20px;
}

.row-label {
  color: $secondary;
  font-size: 12px;
}

.row-value {
  color: $text;
  font-size: 12px;
}

.title {
  color: $text;
  font-size: 16px;
  font-weight: bold;
}

.note {
  color: $secondary;
  font-size: 11px;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4px;
}

.chip-text {
  color: $text;
  font-size: 11px;
}

.layer-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 30px;
  padding: 0 10px;
  margin: 0 -10px;
  border-radius: 7px;
  cursor: pointer;
}

.layer-row:hover {
  background: rgba(255, 255, 255, 0.08);
}

/* -- Transport ------------------------------------------------------------------ */
.transport {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 58px;
  background: $footer;
  padding: 0 10px;
  flex-shrink: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

/* NOTE: Margins rather than gap, Paper leaves gap out of a nested row's natural width so its children get squeezed */
.transport-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.transport-position {
  color: $text;
  font-size: 20px;
  font-weight: bold;
  width: 78px;
  flex-shrink: 0;
}

.transport-label {
  color: $secondary;
  font-size: 11px;
  margin-right: 6px;
  flex-shrink: 0;
}

.transport-value {
  color: $text;
  font-size: 15px;
  font-weight: bold;
  margin: 0 6px 0 0;
  flex-shrink: 0;
}

.spacer {
  flex-grow: 1;
}

/* A quiet rounded button: white text on a faint fill */
.pill {
  display: flex;
  flex-shrink: 0;
  margin: 0 2px;
  align-items: center;
  justify-content: center;
  height: 24px;
  min-width: 24px;
  padding: 0 9px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  cursor: pointer;
}

.pill:hover {
  background: rgba(255, 255, 255, 0.16);
}

.pill-text {
  color: $text;
  font-size: 12px;
}

.segmented {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.08);
}
